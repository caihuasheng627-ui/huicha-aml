DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4-flash-0731

# 竞赛原型边界：不是银行 SSO / 生产网关。
# 留空则 /api 接口开放；填写后请求须带 Header X-Huicha-Token（不要把口令放进 URL）。
HUICHA_DEMO_TOKEN=
HUICHA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# 本地无百炼密钥时可设为 1：Challenger/Reporter 走内置 stub（竞赛演示，不是百炼）。
HUICHA_LLM_STUB=
