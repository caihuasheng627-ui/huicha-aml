DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4-flash-0731

# 可选：DeepSeek 官方平台。有 DEEPSEEK_API_KEY 时优先走 api.deepseek.com + deepseek-chat。
# 不把密钥提交进仓库。产品默认仍是百炼 DASHSCOPE_MODEL。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可选：智谱 GLM。无 DeepSeek 密钥且设置了 ZHIPU_API_KEY 时走 open.bigmodel.cn。
# ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-5.2

# 竞赛原型边界：不是银行 SSO / 生产网关。
# 留空则 /api 接口开放；填写后请求须带 Header X-Huicha-Token（不要把口令放进 URL）。
HUICHA_DEMO_TOKEN=
HUICHA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# 本地无模型密钥时可设为 1：Challenger/Reporter 走内置 stub（竞赛演示）。
HUICHA_LLM_STUB=

# 告警流水窗口：向前天数，默认 90；向后固定 7 天。空 created_at 不加窗口。
HUICHA_TX_WINDOW_DAYS=90
